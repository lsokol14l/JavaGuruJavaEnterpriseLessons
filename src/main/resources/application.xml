<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean name="repo1" class="by.michael.spring.database.repository.UserRepository">
        <constructor-arg name="username" value="Andrey@gmail.com"/>
        <constructor-arg name="poolSize" value="10"/>
        <constructor-arg name="args">
            <list>
                <value>1</value>
                <value>2</value>
                <value>3</value>
            </list>
        </constructor-arg>
        <constructor-arg name="properties">
            <map>
                <entry key="user" value="Andrey"/>
                <entry key="address" value="Minsk"/>
            </map>
        </constructor-arg>
    </bean>

    <bean name="repo2" class="by.michael.spring.database.repository.UserRepository">
        <property name="username" ref="driver"/>
        <property name="poolSize" value="10"/>
        <property name="args">
            <list>
                <value>1</value>
                <value>2</value>
                <ref bean="driver"/>
            </list>
        </property>
        <property name="properties">
            <map>
                <entry key="user" value-ref="driver"/>
                <entry key-ref="driver" value="programmer"/>
            </map>
        </property>
    </bean>

    <bean class="java.lang.String" name="driver">
        <constructor-arg value="PostgresDriver"/>
    </bean>

    <bean class="by.michael.spring.dto.UserDto" name="userDto"/>

    <bean class="by.michael.spring.mapper.UserMapper" name="userMapper">
        <constructor-arg name="userDto" ref="userDto"/>
    </bean>

    <bean class="by.michael.spring.service.UserService" name="service1">
        <constructor-arg name="userMapper" ref="userMapper"/>
        <constructor-arg name="userRepository" ref="repo1"/>
    </bean>
</beans>